# Expense Tracker Server Environment Configuration
PORT=5050
NODE_ENV=production
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/expense_tracker?retryWrites=true&w=majority
JWT_SECRET=your_super_secret_jwt_key_here_change_for_production
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# Email Verification (Nodemailer / Gmail SMTP)
# Set your Gmail address and 16-character Google App Password (generate at https://myaccount.google.com/apppasswords)
EMAIL_SERVICE=gmail
EMAIL_USER=your_gmail_address@gmail.com
EMAIL_PASS=your_16_character_app_password
EMAIL_FROM="Monthly Expense Tracker <noreply@expensetracker.app>"
